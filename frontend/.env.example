# Browser (only NEXT_PUBLIC_* reaches the browser)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
# Optional: Base Sepolia, where CoFHE runs today
NEXT_PUBLIC_BASE_SEPOLIA_RPC=

# Server only
# Pays gas for workers' private withdrawals and income proofs (/api/relay). Use a fresh key, never the
# deployer's, and keep it topped up with testnet MON.
RELAYER_PRIVATE_KEY=
# Optional: the RPC the relayer sends through. Defaults to NEXT_PUBLIC_MONAD_TESTNET_RPC, then the public RPC.
MONAD_TESTNET_RPC_URL=
