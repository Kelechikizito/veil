# Browser (only NEXT_PUBLIC_* reaches the browser)
NEXT_PUBLIC_PRIVY_APP_ID=
# Alchemy's Monad testnet RPC (https://monad-testnet.g.alchemy.com/v2/<key>). It ships to the browser,
# so restrict the key's allowed origins in the Alchemy dashboard. Empty falls back to the public RPC.
NEXT_PUBLIC_MONAD_TESTNET_RPC=

# Server only
# Privy app secret (Dashboard > App settings > Basics). Never prefix it with NEXT_PUBLIC_.
PRIVY_APP_SECRET=
# The relayer for workers' private withdrawals and income proofs (/api/relay): a Privy server wallet,
# app-owned, with gas sponsored by Privy. Create it once with POST https://api.privy.io/v1/wallets
# {"chain_type":"ethereum"} and put its id here.
PRIVY_RELAYER_WALLET_ID=
# Fallback relayer when PRIVY_RELAYER_WALLET_ID is empty: a fresh key that pays gas itself. Never the deployer's.
RELAYER_PRIVATE_KEY=
# Envio HyperSync token (https://app.envio.dev/api-tokens) for /api/announcements. Without it, workers'
# browsers find their private streams by reading every stream over RPC.
ENVIO_API_TOKEN=
# The RPC the relayer and /api routes use, server only: Alchemy, ideally a second key with no origin limit.
# Defaults to NEXT_PUBLIC_MONAD_TESTNET_RPC, then the public RPC.
MONAD_TESTNET_RPC_URL=
