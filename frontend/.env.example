# Browser (only NEXT_PUBLIC_* reaches the browser)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_WLD_ENVIRONMENT=sandbox

# Server only
WORLDID_APP_ID=
WORLDID_RP_ID=
WORLDID_RP_SIGNING_KEY=
# Private key of ATTESTER; must match HumanRegistry.attester()
ATTESTER_PRIVATE_KEY=
# 32 random bytes (openssl rand -hex 32). Never change it after the first registration.
NULLIFIER_SALT=
